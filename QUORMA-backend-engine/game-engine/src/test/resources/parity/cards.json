{
  "_readme": "Cards that the engine's card check (CardPoolChecker) and data/validate.py (check 12) must judge the same way. CardCheckParityTest feeds each card to both. A card has no id here (the test gives each one), and `sets` is added for validate.py. `expect` is ok or reject for both; a case may instead say {engine, validate, why} when the two are known to differ, and the test then asserts exactly that, so the difference cannot move unnoticed.",
  "cases": [
    { "name": "a creature with a keyword", "expect": "ok",
      "card": { "kind": "CREATURE", "rank": 5, "suit": "VINCOLO", "subfaction": "ADATTATI", "atk": 3000, "def": 5000,
                "abilities": [ { "id": "K_PERFORANTE", "params": { "x": 20 } } ] } },
    { "name": "a creature with a keyword and an evolution", "expect": "ok",
      "card": { "kind": "CREATURE", "rank": 5, "suit": "SPIRA", "subfaction": "SEGNATERRA", "atk": 3000, "def": 5000,
                "abilities": [ { "id": "K_PERFORANTE", "params": { "x": 20 } }, { "id": "EVO_CRESCITA", "params": { "permille": 150 } } ] } },
    { "name": "a capped keyword on the rank it is allowed on", "expect": "ok",
      "card": { "kind": "CREATURE", "rank": 1, "suit": "FRATTURA", "subfaction": "SPEZZASIGILLI", "atk": 3850, "def": 5750,
                "abilities": [ { "id": "K_LETALE" } ] } },
    { "name": "three distinct keywords", "expect": "ok",
      "card": { "kind": "CREATURE", "rank": 5, "suit": "VESTIGIO", "subfaction": "PORTANOME", "atk": 3000, "def": 5000,
                "abilities": [ { "id": "K_CONFINE" }, { "id": "K_ISOLA" }, { "id": "K_GUSCIO" } ] } },

    { "name": "a keyword on a rank it is not allowed on", "expect": "reject",
      "card": { "kind": "CREATURE", "rank": 5, "suit": "VINCOLO", "subfaction": "ADATTATI", "atk": 3000, "def": 5000,
                "abilities": [ { "id": "K_LETALE" } ] } },
    { "name": "an evolution on a rank it is not allowed on", "expect": "reject",
      "card": { "kind": "CREATURE", "rank": 5, "suit": "VINCOLO", "subfaction": "ADATTATI", "atk": 3000, "def": 5000,
                "abilities": [ { "id": "EVO_CARNEFICE" } ] } },
    { "name": "four keywords", "expect": "reject",
      "card": { "kind": "CREATURE", "rank": 5, "suit": "VINCOLO", "subfaction": "ADATTATI", "atk": 3000, "def": 5000,
                "abilities": [ { "id": "K_CONFINE" }, { "id": "K_ISOLA" }, { "id": "K_GUSCIO" }, { "id": "K_CONFORMITA" } ] } },
    { "name": "two evolutions", "expect": "reject",
      "card": { "kind": "CREATURE", "rank": 5, "suit": "VINCOLO", "subfaction": "ADATTATI", "atk": 3000, "def": 5000,
                "abilities": [ { "id": "EVO_CRESCITA", "params": { "permille": 150 } }, { "id": "EVO_TRINCEA", "params": { "permille": 150 } } ] } },
    { "name": "the same keyword twice", "expect": "reject",
      "card": { "kind": "CREATURE", "rank": 5, "suit": "VINCOLO", "subfaction": "ADATTATI", "atk": 3000, "def": 5000,
                "abilities": [ { "id": "K_CONFINE" }, { "id": "K_CONFINE" } ] } },
    { "name": "an ability that does not exist", "expect": "reject",
      "card": { "kind": "CREATURE", "rank": 5, "suit": "VINCOLO", "subfaction": "ADATTATI", "atk": 3000, "def": 5000,
                "abilities": [ { "id": "K_NON_ESISTE" } ] } },
    { "name": "a required param left out", "expect": "reject",
      "card": { "kind": "CREATURE", "rank": 5, "suit": "VINCOLO", "subfaction": "ADATTATI", "atk": 3000, "def": 5000,
                "abilities": [ { "id": "K_SCUDO" } ] } },
    { "name": "a param the ability does not have", "expect": "reject",
      "card": { "kind": "CREATURE", "rank": 5, "suit": "VINCOLO", "subfaction": "ADATTATI", "atk": 3000, "def": 5000,
                "abilities": [ { "id": "K_CONFINE", "params": { "nope": 1 } } ] } },
    { "name": "a field a creature does not have", "expect": "reject",
      "card": { "kind": "CREATURE", "rank": 5, "suit": "VINCOLO", "subfaction": "ADATTATI", "atk": 3000, "def": 5000, "colour": "red",
                "abilities": [ { "id": "K_CONFINE" } ] } },
    { "name": "a rank above the King", "expect": "reject",
      "card": { "kind": "CREATURE", "rank": 14, "suit": "VINCOLO", "subfaction": "ADATTATI", "atk": 3000, "def": 5000,
                "abilities": [ { "id": "K_CONFINE" } ] } },
    { "name": "a suit that does not exist", "expect": "reject",
      "card": { "kind": "CREATURE", "rank": 5, "suit": "CUORI", "subfaction": "ADATTATI", "atk": 3000, "def": 5000,
                "abilities": [ { "id": "K_CONFINE" } ] } },
    { "name": "a subfaction that does not exist", "expect": "reject",
      "card": { "kind": "CREATURE", "rank": 5, "suit": "VINCOLO", "subfaction": "INVENTATI", "atk": 3000, "def": 5000,
                "abilities": [ { "id": "K_CONFINE" } ] } },
    { "name": "a negative attack", "expect": "reject",
      "card": { "kind": "CREATURE", "rank": 5, "suit": "VINCOLO", "subfaction": "ADATTATI", "atk": -1, "def": 5000,
                "abilities": [ { "id": "K_CONFINE" } ] } },
    { "name": "a defence of zero", "expect": "reject",
      "card": { "kind": "CREATURE", "rank": 5, "suit": "VINCOLO", "subfaction": "ADATTATI", "atk": 3000, "def": 0,
                "abilities": [ { "id": "K_CONFINE" } ] } },
    { "name": "an attack that is not a number", "expect": "reject",
      "card": { "kind": "CREATURE", "rank": 5, "suit": "VINCOLO", "subfaction": "ADATTATI", "atk": "3000", "def": 5000,
                "abilities": [ { "id": "K_CONFINE" } ] } },
    { "name": "a spell that names a keyword", "expect": "reject",
      "card": { "kind": "SPELL", "faction": "RESISTENZA_UMANA", "abilities": [ { "id": "K_CONFINE" } ] } },
    { "name": "a written effect that does not exist", "expect": "reject",
      "card": { "kind": "SPELL", "faction": "POTENZE_ARTIFICIALI",
                "abilities": [ { "expansions": [ { "effect_id": "E999", "target_id": "S30", "duration": "D_Istantanea", "class": "I" } ] } ] } },
    { "name": "a written ability with no expansion", "expect": "reject",
      "card": { "kind": "EQUIPMENT", "faction": "RESISTENZA_UMANA", "abilities": [ { "expansions": [] } ] } },
    { "name": "a card of an unknown kind", "expect": "reject",
      "card": { "kind": "TRAP", "faction": "RESISTENZA_UMANA", "abilities": [ { "expansions": [] } ] } },

    { "name": "a vanilla creature with no ability at all", "expect": "ok",
      "card": { "kind": "CREATURE", "rank": 5, "suit": "VINCOLO", "subfaction": "ADATTATI", "atk": 3000, "def": 5000, "abilities": [] } },
    { "name": "a spell with no ability", "expect": "reject",
      "card": { "kind": "SPELL", "faction": "RESISTENZA_UMANA", "abilities": [] } },
    { "name": "an equipment with no ability", "expect": "reject",
      "card": { "kind": "EQUIPMENT", "faction": "POTENZE_ARTIFICIALI", "abilities": [] } }
  ]
}
