<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>quorma</groupId>
        <artifactId>quorma-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>game-engine</artifactId>
    <name>Quorma Game Engine</name>
    <description>Pure-Java deterministic match simulation core. No Spring, no framework.</description>
    <packaging>jar</packaging>

    <dependencies>
        <!-- JSON parsing (Jackson 3, tree model only). Version from the BOM in the parent. -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- Test only. Versions come from the BOM imported in the parent. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- Bundle the rules data into the jar, re-copied on every build so a rebalance in data/ is picked up. -->
            <resource>
                <directory>../data</directory>
                <includes>
                    <include>*.json</include>
                </includes>
                <targetPath>ruleset</targetPath>
                <filtering>false</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.7.0</version>
                <executions>
                    <execution>
                        <id>no-spring-in-game-engine</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.springframework</exclude>
                                        <exclude>org.springframework.*</exclude>
                                    </excludes>
                                    <message>game-engine must not depend on Spring.</message>
                                </bannedDependencies>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>com.fasterxml.jackson.core:jackson-databind</exclude>
                                    </excludes>
                                    <message>Use Jackson 3 (tools.jackson), not Jackson 2 databind.</message>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
