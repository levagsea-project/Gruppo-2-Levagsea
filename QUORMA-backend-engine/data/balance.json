    "variants_per_rank_suit": {
      "1": 2,
      "2": 3,
      "3": 3,
      "4": 4
    },
    "variants_note": "Piu' versioni della stessa carta (fazione, rango, seme) con abilita' diverse. Il mazzo ne usa una sola per rango e seme, quindi le versioni sono il materiale con cui si costruisce il mazzo.",
    "keyword_slot_fill_pct_by_tier": {
      "1": 30,
      "2": 50,
      "3": 75,
      "4": 100
    },
    "no_forced_signature": "Nessun rango e' obbligato ad avere una abilita' di firma: l'Asso puo' avere qualsiasi abilita' open, anche debole.",
    "themed_draw_pct": 70,
    "role_draw_pct": 50,
    "selection_procedure": "Per ogni slot (keyword, Evoluzione) di una carta: 1) con probabilita' themed_draw_pct i candidati si restringono alle abilita' idonee al rango che condividono un tema col seme (se non ce ne sono, nessuna restrizione); 2) con probabilita' role_draw_pct si restringono ulteriormente a quelle in ranks.json -> role_affinity del Tier (se non ce ne sono, nessuna restrizione); 3) scelta uniforme tra i candidati. Le abilita' capped e limited hanno pochi ranghi idonei, quindi il loro tetto non dipende dalla scelta.",
    "fit_targets": {
      "min_suit_match_pct": 60,
      "min_role_match_pct": 40,
