# Copia questo file in .env e compila i valori.

# Indirizzo pubblico del sito, senza "/" finale (es. https://quorma.example).
# Serve per canonical, anteprime social e sitemap.xml. Vuoto finché non c'è un dominio.
VITE_SITE_URL=

# Backend usato dal proxy di sviluppo per /auth (docker compose).
BACKEND_URL=http://localhost:8080

# true = accesso demo senza backend: qualsiasi nome e password vanno bene.
# Vale solo con "npm run dev", mai nella build di produzione.
VITE_AUTH_DEMO=false
