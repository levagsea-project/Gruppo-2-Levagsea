# https://editorconfig.org (VS Code needs the "EditorConfig" extension; IntelliJ reads it natively)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{java,xml,json,yml,yaml,sql,py,md}]
indent_size = 4

[*.{js,jsx,ts,tsx,css,html}]
indent_size = 2

# Markdown uses two trailing spaces for a hard line break
[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab
